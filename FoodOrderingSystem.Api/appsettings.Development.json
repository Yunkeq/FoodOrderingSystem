{
  "Serilog": {
    "Using": [ "Serilog.Sinks.console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },

    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Db": {
    "ConnectionString": "Host=localhost;Port=5432;Database=FoodOrderingSystem;Username=postgres;Password=zaq1@WSX;Include Error Detail=true",
    "Schema": "FoodOrdering"
  },

  "Jwt": {
    "Audience": "http://localhost:7161",
    "Issuer": "http://localhost:7161",
    "SigningKey": "super-secret-signing-key-super-secret-again-and-again",
    "AccessTokenExpirationMinutes": "15",
    "RefreshTokenExpirationDays": "5"
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "Password": "zaq1@WSX"
  }
}